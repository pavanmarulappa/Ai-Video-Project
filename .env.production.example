# No domain required for now. :80 serves HTTP; use an SSH tunnel for private access.
SITE_ADDRESS=:80
CADDY_HTTP_BIND=127.0.0.1:8080
CADDY_HTTPS_BIND=127.0.0.1:8443

# Generate independent random values with: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
ADMIN_EMAIL=your-login-email@example.com
POSTGRES_DB=frameforge
POSTGRES_USER=frameforge
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# fal.ai is the initial real video provider. Set its key before generating.
VIDEO_PROVIDER=fal
RUNWAY_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_MODEL=alibaba/wan-3
FAL_KEY=
FAL_VIDEO_ENDPOINT=alibaba/wan-3.0/text-to-video

# local stores videos in a persistent Docker volume. S3 is optional.
STORAGE_DRIVER=local
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
WORKER_CONCURRENCY=2
