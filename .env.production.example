# No domain required for now. :80 serves HTTP; use an SSH tunnel for private access.
SITE_ADDRESS=:80
CADDY_HTTP_BIND=127.0.0.1:8080
CADDY_HTTPS_BIND=127.0.0.1:8443

# Generate independent random values with: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
POSTGRES_DB=frameforge
POSTGRES_USER=frameforge
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Start with mock. For paid generation set VIDEO_PROVIDER=runway and provide RUNWAY_API_KEY.
VIDEO_PROVIDER=mock
RUNWAY_API_KEY=
MOCK_VIDEO_URL=https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4

# local stores videos in a persistent Docker volume. S3 is optional.
STORAGE_DRIVER=local
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
WORKER_CONCURRENCY=2
