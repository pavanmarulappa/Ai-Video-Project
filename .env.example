# Copy this file to .env, set a real provider API key, and change AUTH_SECRET before sharing or deploying.
DATABASE_URL="postgresql://video:video@localhost:5432/videogen?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="local-dev-only-change-this-to-a-long-random-secret"
ADMIN_EMAIL=""

# fal.ai is the initial real video provider. Add FAL_KEY before generating.
VIDEO_PROVIDER="fal"
RUNWAY_API_KEY=""
REPLICATE_API_TOKEN=""
REPLICATE_MODEL="alibaba/wan-3"
FAL_KEY=""
FAL_VIDEO_ENDPOINT="alibaba/wan-3.0/text-to-video"

# Local storage is the default. For S3-compatible storage, set STORAGE_DRIVER=s3 and fill these in.
STORAGE_DRIVER="local"
VIDEO_STORAGE_DIR="data/videos"
AWS_REGION="us-east-1"
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
