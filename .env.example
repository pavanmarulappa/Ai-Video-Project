# Copy this file to .env and change AUTH_SECRET before sharing or deploying.
DATABASE_URL="postgresql://video:video@localhost:5432/videogen?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="local-dev-only-change-this-to-a-long-random-secret"

# mock is ready to run locally. Set provider=runway and RUNWAY_API_KEY to use Runway.
VIDEO_PROVIDER="mock"
RUNWAY_API_KEY=""
MOCK_VIDEO_URL="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4"

# Local storage is the default. For S3-compatible storage, set STORAGE_DRIVER=s3 and fill these in.
STORAGE_DRIVER="local"
VIDEO_STORAGE_DIR="data/videos"
AWS_REGION="us-east-1"
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
